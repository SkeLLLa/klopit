{
  "$schema": "http://json.schemastore.org/package.json",
  "name": "klopit",
  "version": "1.25.2",
  "private": true,
  "description": "Polish PIT tax calculator from brokerage income.",
  "keywords": [
    "pit",
    "pit-38",
    "tax",
    "calculator",
    "poland",
    "brokerage",
    "dividends",
    "shares"
  ],
  "homepage": "https://github.com/SkeLLLa/klopit/blob/master/README.md",
  "bugs": {
    "url": "https://github.com/SkeLLLa/klopit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SkeLLLa/klopit.git"
  },
  "license": "AGPL-3.0-only",
  "author": "kloPIT community",
  "type": "module",
  "directories": {
    "lib": "src",
    "doc": "docs",
    "example": "examples",
    "test": "test"
  },
  "scripts": {
    "build": "pnpm run build:app && pnpm run build:format",
    "build:app": "pnpm run generate:ai && vite build && svelte-sitemap",
    "build:clean": "rm -rf build",
    "build:format": "pretty-quick",
    "dev": "vite dev",
    "generate:ai": "tsx scripts/generate-ai-metadata.ts",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations",
    "lint": "pnpm run lint:types && pnpm run lint:codestyle",
    "lint:codestyle": "eslint",
    "lint:types": "svelte-check --tsconfig ./tsconfig.json",
    "preview": "vite preview",
    "release": "semantic-release",
    "test": "pnpm run lint && pnpm run test:unit",
    "test:unit": "node --no-warnings --import tsx --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=lcov.info --test 'test/*.test.ts' --test-coverage-exclude=test/**",
    "test:unit:local": "node --no-warnings --import tsx --experimental-test-coverage --test 'test/*.test.ts' --test-coverage-exclude=test/**"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/onest": "^5.3.0",
    "@unovis/svelte": "^1.6.7",
    "@unovis/ts": "^1.6.7",
    "dexie": "^4.4.5",
    "lucide-svelte": "^1.0.1",
    "svelte": "^5.56.10",
    "svelty-picker": "^6.1.6",
    "typeid-js": "^1.2.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.2",
    "@inlang/paraglide-js": "^2.25.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@skellla/lint-config": "^3.0.5",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node-lts": "^24.0.1",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.4.0",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "eslint": "^10.5.0",
    "eslint-plugin-svelte": "^3.23.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "globstar": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.6",
    "pretty-quick": "^4.2.2",
    "semantic-release": "^25.0.9",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "svelte-sitemap": "^3.2.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-mkcert": "^2.1.0"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=20"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "cookie": "^0.7.0",
      "postcss": "^8.5.10",
      "uuid": "^14.0.0"
    }
  }
}
