{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "quoteProps": "consistent",
  "trailingComma": "all",
  "arrowParens": "always",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "jsdoc": true,
  "sortImports": {
    "groups": [["builtin"], ["external"], ["parent", "sibling", "index"]]
  },
  "sortPackageJson": true,
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "mise.lock",
    "src/lib/paraglide/**",
    "static/**",
    "build/**",
    "coverage/**",
    "**/*.min.*",
    "docs/CHANGELOG.md",
    ".mcp.json"
  ]
}
